# Скопируй этот файл в .env и заполни своими данными
# cp .env.example .env

# --- Spotify Developer Dashboard → https://developer.spotify.com/dashboard ---
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Должен совпадать с тем, что добавлен в Redirect URIs в Dashboard
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/callback

# Любая случайная строка — нужна для подписи сессий
SESSION_SECRET=moodwave_super_secret_123

# Порт сервера
PORT=3000
